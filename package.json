{
    "name": "web",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "scripts": {
        "dev": "vite dev",
        "build": "vite build",
        "preview": "vite preview",
        "prepare": "svelte-kit sync",
        "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "preview:cloudflare": "npm run build && wrangler dev",
        "deploy": "npm run build && wrangler deploy",
        "test": "playwright test",
        "format": "prettier --write .",
        "lint": "prettier --check ."
    },
    "devDependencies": {
        "@pierre/highlights": "^0.2.0",
        "@playwright/test": "^1.63.0",
        "@sveltejs/adapter-cloudflare": "^7.2.9",
        "@sveltejs/kit": "^2.63.0",
        "@sveltejs/vite-plugin-svelte": "^7.1.2",
        "@types/node": "^22.20.2",
        "@unocss/extractor-svelte": "^66.11.0",
        "mdsvex": "^0.12.8",
        "prettier": "^3.9.10",
        "prettier-plugin-svelte": "^4.1.1",
        "rehype-slug": "^6.0.0",
        "svelte": "^5.56.1",
        "svelte-check": "^4.6.0",
        "typescript": "^6.0.3",
        "unocss": "^66.11.0",
        "vite": "^8.0.16",
        "wrangler": "^4.131.0"
    },
    "engines": {
        "node": "24.18.0"
    },
    "dependencies": {
        "@fontsource/crimson-pro": "^5.3.0",
        "@fontsource/fraunces": "^5.3.0",
        "@fontsource/ibm-plex-mono": "^5.3.0"
    },
    "allowScripts": {
        "fsevents@2.3.3": true,
        "esbuild@0.28.2": true,
        "workerd@1.20261019.1": true
    }
}
