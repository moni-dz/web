{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "web",
	"compatibility_date": "2026-09-07",
	"compatibility_flags": [
		"nodejs_als"
	],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"upload_source_maps": true,
	"workers_dev": false
}
